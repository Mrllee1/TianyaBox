 static bool EnableTracingIfNecessaryOnce(const Settings& vm_settings) {
+  // AppBox's target-specific Guest.bundle never executes JIT pages on the host
+  // CPU; downloaded ARM64 instructions are data consumed by the Dart
+  // simulator. Tracing/debugserver is therefore not a prerequisite for it.
+  if (vm_settings.assets_path.find("Guest.bundle") != std::string::npos) {
+    return true;
+  }
+
   if (IsLaunchedByFlutterCLI(vm_settings)) {
     return true;
