 - (void)onDisplayLink:(CADisplayLink*)link {
-  CFTimeInterval delay = CACurrentMediaTime() - link.timestamp;
+  // iOS 26 can report a display-link timestamp a few ticks ahead of
+  // CACurrentMediaTime(). Treat that clock-domain rounding as zero latency so
+  // the resulting frame start never lies in the future.
+  CFTimeInterval delay = fmax(0, CACurrentMediaTime() - link.timestamp);
   fml::TimePoint frame_start_time = fml::TimePoint::Now() - fml::TimeDelta::FromSecondsF(delay);
 
   CFTimeInterval duration = link.targetTimestamp - link.timestamp;
